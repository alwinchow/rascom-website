@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap');

:root{
  --ink:#0A0A0A;
  --paper:#F6F7F9;
  --white:#FFFFFF;
  --azure:#3FC1E0;
  --azure-deep:#1C7FA0;
  --navy:#0F1B2B;
  --navy-2:#142235;
  --line:#E2E5EA;
  --line-dark:rgba(255,255,255,0.12);
  --maxw:1180px;
  --radius:2px;
}
*,*::before,*::after{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{margin:0;background:var(--paper);color:var(--ink);font-family:'Inter',system-ui,sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased;}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
ul{margin:0;padding:0;list-style:none;}
h1,h2,h3,h4{font-family:'Space Grotesk',sans-serif;font-weight:700;line-height:1.1;margin:0;letter-spacing:-0.01em;}
p{margin:0;}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px;}

/* ---------- Eyebrow ---------- */
.eyebrow{font-family:'JetBrains Mono',monospace;font-size:12.5px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--azure-deep);display:inline-flex;align-items:center;gap:10px;}
.eyebrow::before{content:"";width:18px;height:1px;background:var(--azure-deep);display:inline-block;}
.on-dark .eyebrow,.on-dark.eyebrow{color:var(--azure);}
.on-dark .eyebrow::before{background:var(--azure);}

/* ---------- Ticket edge ---------- */
.ticket-edge{position:relative;height:14px;width:100%;background:radial-gradient(circle 7px at 0 0, transparent 7px, var(--paper) 7.5px) 0 0/28px 14px repeat-x;}
.ticket-edge.on-navy{background:radial-gradient(circle 7px at 0 0, transparent 7px, var(--navy) 7.5px) 0 0/28px 14px repeat-x;}
.ticket-tag{font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600;letter-spacing:0.06em;color:var(--azure-deep);border:1px solid var(--line);border-radius:20px;padding:5px 12px 5px 10px;display:inline-flex;align-items:center;gap:7px;background:var(--white);}
.ticket-tag::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--azure);}

/* ---------- Header / Nav ---------- */
.site-header{position:sticky;top:0;z-index:100;background:rgba(10,10,10,0.95);backdrop-filter:saturate(140%) blur(8px);border-bottom:1px solid var(--line-dark);}
.site-header .wrap{display:flex;align-items:center;justify-content:space-between;height:76px;}

/* Logo */
.logo-link{text-decoration:none;}
.logo{display:inline-flex;align-items:center;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:25px;letter-spacing:0.2px;color:#fff;line-height:1;}
.logo-mark{width:24px;height:24px;border-radius:50%;background:var(--azure);display:inline-flex;align-items:center;justify-content:center;margin:0 1px;flex-shrink:0;}
.logo-mark svg{display:block;}
.logo.logo-sm{font-size:19px;}
.logo.logo-sm .logo-mark{width:19px;height:19px;}

/* Desktop nav */
.nav{display:flex;gap:2px;align-items:center;}
.nav a{color:#D7DBE2;font-size:14.5px;font-weight:500;padding:10px 14px;border-radius:20px;transition:color .15s ease,background .15s ease;}
.nav a:hover{color:#fff;background:rgba(255,255,255,0.07);}
.nav a.active{color:var(--ink);background:var(--azure);}
.nav-cta{margin-left:8px;background:var(--azure) !important;color:var(--ink) !important;font-weight:600 !important;}

/* Cloud CRM special tab */
.nav-crm{position:relative;color:var(--azure) !important;font-weight:600 !important;border:1px solid rgba(63,193,224,0.45) !important;border-radius:20px !important;padding:8px 14px !important;animation:crm-pulse 2.8s ease-in-out infinite;}
.nav-crm:hover{background:rgba(63,193,224,0.12) !important;border-color:var(--azure) !important;box-shadow:0 0 12px rgba(63,193,224,0.25) !important;animation:none !important;}
.nav-crm.active{background:var(--azure) !important;color:var(--ink) !important;animation:none !important;}
@keyframes crm-pulse{0%,100%{box-shadow:0 0 0 0 rgba(63,193,224,0);}50%{box-shadow:0 0 0 4px rgba(63,193,224,0.18);}}
.nav-crm::after{content:"NEW";position:absolute;top:-7px;right:-4px;font-size:9px;font-weight:700;letter-spacing:0.06em;background:var(--azure);color:var(--ink);border-radius:8px;padding:1px 5px;font-family:'JetBrains Mono',monospace;line-height:1.6;}
.nav-crm.active::after{background:var(--ink);color:var(--azure);}

/* Hamburger — hidden on desktop */
.menu-toggle{display:none;background:none;border:0;color:#fff;font-size:26px;cursor:pointer;padding:4px 8px;line-height:1;z-index:200;position:relative;}

/* ========== MOBILE NAV ========== */
@media (max-width:880px){
  .menu-toggle{display:block;}

  .nav{
    display:flex !important;
    flex-direction:column;
    align-items:stretch;
    position:fixed;
    top:76px;
    left:0;
    right:0;
    height:calc(100vh - 76px);
    background:#0A0A0A;
    padding:16px 20px 32px;
    gap:4px;
    overflow-y:auto;
    z-index:9999;
    transform:translateX(100%);
    transition:transform .25s ease;
  }
  .nav.open{
    transform:translateX(0);
  }
  .nav a{
    display:block !important;
    width:100%;
    padding:16px 16px !important;
    font-size:17px !important;
    border-radius:8px !important;
    color:#D7DBE2 !important;
    border:none !important;
    animation:none !important;
    background:transparent !important;
    text-align:left;
  }
  .nav a:hover,
  .nav a.active{
    background:rgba(255,255,255,0.08) !important;
    color:#fff !important;
  }
  .nav a.nav-crm{
    color:var(--azure) !important;
    background:rgba(63,193,224,0.08) !important;
  }
  .nav a.nav-cta{
    margin-left:0 !important;
    margin-top:12px;
    background:var(--azure) !important;
    color:#0A0A0A !important;
    text-align:center !important;
    font-weight:600 !important;
  }
  .nav-crm::after{display:none !important;}
}

/* ---------- Buttons ---------- */
.btn{display:inline-flex;align-items:center;gap:8px;font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:15px;padding:13px 24px;border-radius:30px;border:1px solid transparent;cursor:pointer;transition:transform .15s ease,background .15s ease,color .15s ease,border-color .15s ease;}
.btn:hover{transform:translateY(-2px);}
.btn-primary{background:var(--azure);color:var(--ink);}
.btn-primary:hover{background:#56cce9;}
.btn-outline{border-color:var(--line);color:var(--ink);background:transparent;}
.btn-outline:hover{border-color:var(--ink);}
.on-dark .btn-outline{border-color:var(--line-dark);color:#fff;}
.on-dark .btn-outline:hover{border-color:#fff;}

/* ---------- Hero ---------- */
.hero{background:var(--ink);color:#fff;position:relative;overflow:hidden;padding:64px 0 0;}
.hero::after{content:"";position:absolute;right:-10%;top:-20%;width:60%;height:140%;background:linear-gradient(135deg,transparent 49%,rgba(63,193,224,0.18) 50%,rgba(63,193,224,0.18) 58%,transparent 59%);}
.hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:48px;align-items:center;padding-bottom:56px;position:relative;}
.hero h1{font-size:clamp(34px,5vw,58px);margin:18px 0 22px;color:#fff;}
.hero h1 em{font-style:normal;color:var(--azure);}
.hero p.lead{font-size:17.5px;color:#B9C0CC;max-width:46ch;margin-bottom:30px;}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap;}

/* Queue card */
.queue-card{background:var(--navy-2);border:1px solid var(--line-dark);border-radius:10px;padding:24px;font-family:'JetBrains Mono',monospace;}
.queue-card .qc-head{display:flex;justify-content:space-between;align-items:center;font-size:12px;letter-spacing:0.08em;color:#8893A3;text-transform:uppercase;margin-bottom:16px;}
.qc-row{display:flex;justify-content:space-between;align-items:center;padding:13px 0;border-top:1px dashed var(--line-dark);font-size:14px;}
.qc-row:first-of-type{border-top:none;}
.qc-num{color:var(--azure);font-weight:600;}
.qc-status{font-size:11px;padding:3px 9px;border-radius:20px;background:rgba(63,193,224,0.15);color:var(--azure);}
.qc-status.done{background:rgba(255,255,255,0.07);color:#8893A3;}

/* ---------- Sections ---------- */
section{padding:88px 0;}
.section-head{max-width:640px;margin-bottom:48px;}
.section-head h2{font-size:clamp(26px,3.4vw,38px);margin-top:14px;}
.section-head p{color:#5B6472;font-size:16.5px;margin-top:14px;}
.on-dark{background:var(--navy);color:#fff;}
.on-dark .section-head p{color:#9AA4B2;}
.on-dark h2,.on-dark h3{color:#fff;}

/* ---------- Cards ---------- */
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;}
.card{background:var(--white);border:1px solid var(--line);border-radius:8px;padding:30px 26px;transition:border-color .2s ease,transform .2s ease;}
.card:hover{border-color:var(--azure);transform:translateY(-3px);}
.card .num{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--azure-deep);font-weight:600;}
.card h3{font-size:19px;margin:14px 0 10px;}
.card p{color:#5B6472;font-size:15px;}
.on-dark .card{background:var(--navy-2);border-color:var(--line-dark);}
.on-dark .card p{color:#9AA4B2;}
.on-dark .card:hover{border-color:var(--azure);}

/* ---------- Share bars ---------- */
.share-row{display:flex;align-items:center;gap:18px;margin-bottom:18px;}
.share-label{width:200px;font-size:14.5px;font-weight:600;flex-shrink:0;}
.share-bar-track{flex:1;height:10px;background:var(--line);border-radius:6px;overflow:hidden;}
.share-bar-fill{height:100%;background:var(--azure);border-radius:6px;}
.share-pct{width:48px;text-align:right;font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:600;}

/* ---------- Timeline ---------- */
.timeline{border-left:2px solid var(--line);padding-left:32px;margin-left:6px;}
.t-item{position:relative;padding-bottom:40px;}
.t-item:last-child{padding-bottom:0;}
.t-item::before{content:"";position:absolute;left:-39px;top:4px;width:12px;height:12px;border-radius:50%;background:var(--azure);border:3px solid var(--paper);}
.t-year{font-family:'JetBrains Mono',monospace;color:var(--azure-deep);font-weight:600;font-size:14px;}
.t-item h3{font-size:18px;margin:6px 0 8px;}
.t-item p{color:#5B6472;font-size:15px;}

/* ---------- Portfolio ---------- */
.proj-card{border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--white);}
.proj-thumb{height:190px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.proj-body{padding:22px 24px;}
.proj-body a{display:inline-block;margin-top:14px;}
.proj-tag{font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.06em;color:var(--azure-deep);text-transform:uppercase;font-weight:600;}
.proj-body h3{font-size:19px;margin:10px 0 8px;}
.proj-body p{font-size:14.5px;color:#5B6472;}

/* ---------- Partners ---------- */
.partner-band{display:grid;grid-template-columns:1fr 1fr;gap:24px;}
.partner-card{background:var(--white);border:1px solid var(--line);border-radius:8px;padding:32px;}
.partner-card .pname{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:21px;margin-bottom:6px;}
.partner-card .prole{font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--azure-deep);margin-bottom:14px;display:block;}
.partner-card p{color:#5B6472;font-size:15px;margin-bottom:16px;}
.partner-card a.visit{font-size:14px;font-weight:600;color:var(--ink);border-bottom:1px solid var(--azure);}

/* ---------- CRM pills ---------- */
.pill{font-family:'JetBrains Mono',monospace;font-size:12.5px;font-weight:600;border:1px solid var(--line-dark);border-radius:20px;padding:8px 16px;color:#D7DBE2;}
.pill-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;}

/* ---------- Stats ---------- */
.stat-row{display:flex;gap:0;border:1px solid var(--line);border-radius:8px;overflow:hidden;}
.stat{flex:1;padding:26px 22px;border-right:1px solid var(--line);}
.stat:last-child{border-right:none;}
.stat .v{font-family:'Space Grotesk',sans-serif;font-size:30px;font-weight:700;color:var(--azure-deep);}
.stat .l{font-size:13px;color:#5B6472;margin-top:6px;}

/* ---------- Contact ---------- */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;}
.info-row{display:flex;gap:16px;padding:18px 0;border-top:1px solid var(--line);}
.info-row:first-child{border-top:none;}
.info-row .ik{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--azure-deep);text-transform:uppercase;letter-spacing:0.08em;width:120px;flex-shrink:0;padding-top:2px;}
.info-row .iv{font-size:15.5px;}
.info-row .iv a{border-bottom:1px solid var(--line);}
.info-row .iv a:hover{border-color:var(--ink);}
.field{margin-bottom:18px;}
.field label{display:block;font-size:13px;font-weight:600;margin-bottom:7px;font-family:'JetBrains Mono',monospace;letter-spacing:0.04em;color:#5B6472;}
.field input,.field textarea,.field select{width:100%;padding:13px 14px;border:1px solid var(--line);border-radius:6px;font-family:'Inter',sans-serif;font-size:15px;background:var(--white);color:var(--ink);}
.field textarea{resize:vertical;min-height:120px;}
.field input:focus,.field textarea:focus,.field select:focus{outline:2px solid var(--azure);outline-offset:1px;border-color:var(--azure);}

/* ---------- Footer ---------- */
footer{background:var(--ink);color:#9AA4B2;padding:56px 0 28px;}
.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;margin-bottom:40px;}
.footer-grid h4{color:#fff;font-size:13px;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:16px;font-family:'JetBrains Mono',monospace;font-weight:600;}
.footer-grid ul li{margin-bottom:10px;}
.footer-grid a:hover{color:#fff;}
.footer-grid p{font-size:14px;line-height:1.7;max-width:32ch;color:#8893A3;}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line-dark);padding-top:24px;font-size:13px;color:#6E7787;flex-wrap:wrap;gap:10px;}

/* ---------- Page hero ---------- */
.page-hero{background:var(--ink);color:#fff;padding:64px 0 56px;}
.page-hero h1{font-size:clamp(30px,4.4vw,46px);margin-top:16px;}
.page-hero p{color:#B9C0CC;max-width:60ch;margin-top:16px;font-size:16.5px;}

/* ---------- Utility ---------- */
.mt-48{margin-top:48px;}
.center{text-align:center;margin-left:auto;margin-right:auto;}

/* ========== RESPONSIVE ========== */
@media (max-width:900px){
  .grid-3{grid-template-columns:1fr 1fr;}
  .grid-2{grid-template-columns:1fr;}
  .partner-band{grid-template-columns:1fr;}
  .contact-grid{grid-template-columns:1fr;}
  .footer-grid{grid-template-columns:1fr 1fr;}
}

@media (max-width:768px){
  .hero-grid{grid-template-columns:1fr !important;}
  .hero-grid > div:last-child{display:none;}
  .stat-row{flex-wrap:wrap;}
  .stat{flex:1 1 50%;border-bottom:1px solid var(--line);}
  section{padding:56px 0;}
  .page-hero{padding:44px 0 36px;}
}

@media (max-width:620px){
  .grid-3{grid-template-columns:1fr;}
  .footer-grid{grid-template-columns:1fr;}
  .wrap{padding:0 18px;}
  .hero h1{font-size:32px;}
  .hero p.lead{font-size:16px;}
  .hero-actions{flex-direction:column;}
  .hero-actions .btn{width:100%;justify-content:center;}
  .stat{flex:1 1 100%;}
  .pill{font-size:11px;padding:6px 12px;}
  .share-label{width:130px;font-size:13px;}
}
